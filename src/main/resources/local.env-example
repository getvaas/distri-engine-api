DATASOURCE___PAYMENTS_DB___URL=jdbc:mysql://dev.db.app.getvaas.com/payments_db?useUnicode=yes&characterEncoding=UTF-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=UTC&useSSL=false
DATASOURCE___PAYMENTS_DB___USERNAME=root
DATASOURCE___PAYMENTS_DB___PASSWORD=set_your_password

DATASOURCE___MASTER_SERVICER_DB___URL=jdbc:mysql://dev.db.app.getvaas.com/master_trust_servicer?useUnicode=yes&characterEncoding=UTF-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=UTC&useSSL=false
DATASOURCE___MASTER_SERVICER_DB___USERNAME=root
DATASOURCE___MASTER_SERVICER_DB___PASSWORD=set_your_password

# Flyway (deshabilitado por default en todos los ambientes). Corre por separado contra cada
# datasource (payments_db y master_trust_servicer), cada uno con sus propias migraciones en
# db/scripts/migration/{payments_db|master_trust_servicer} — ver FlywayConfig.
FLYWAY_ENABLED=false

# Vaas Security
VAAS_SECURITY_JWK_DOMAIN=your_auth0_domain
INFRA_SECURITY_INTERNAL_SERVICE_HEADER=your_internal_service_header_secret

# Redis (compartido a nivel Vaas, usado por ShedLock para el lock distribuido del cron)
REDIS___HOST=localhost
REDIS___PORT=6379
REDIS___SSL___ENABLED=false
REDIS___SSL___DISABLE_PEER_VERIFICATION=false
